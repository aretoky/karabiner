{
  "description": "スペース数字レイヤー: スペースキー修飾",
  "manipulators": [
    {
      "from": {
        "key_code": "spacebar",
        "modifiers": {
          "optional": [
            "any"
          ]
        }
      },
      "parameters": {
        "basic.to_if_alone_timeout_milliseconds": 500
      },
      "to": [
        {
          "set_variable": {
            "name": "space_layer",
            "value": 1
          }
        }
      ],
      "to_after_key_up": [
        {
          "set_variable": {
            "name": "space_layer",
            "value": 0
          }
        }
      ],
      "to_if_alone": [
        {
          "key_code": "spacebar"
        }
      ],
      "type": "basic"
    }
  ]
}
