{
  "description": "shift + control + tab :Move unread previous channel or DM in slack.",
  "manipulators": [
    {
      "conditions": [
        {
          "bundle_identifiers": [
            "^com\\.tinyspeck\\.slackmacgap$"
          ],
          "type": "frontmost_application_if"
        }
      ],
      "from": {
        "key_code": "tab",
        "modifiers": {
          "mandatory": [
            "command",
            "shift"
          ]
        }
      },
      "to": [
        {
          "key_code": "up_arrow",
          "modifiers": [
            "option",
            "shift"
          ]
        }
      ],
      "type": "basic"
    }
  ]
}
